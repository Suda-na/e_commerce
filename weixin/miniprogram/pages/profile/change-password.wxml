<!-- 修改密码页面 -->
<view class="page-container">
  <!-- 表单区域 -->
  <view class="form-container">
    <!-- 原密码 -->
    <view class="form-group">
      <view class="input-label">原密码</view>
      <view class="input-wrapper {{oldPasswordError ? 'input-error' : ''}}">
        <input 
          class="form-input"
          type="{{showOldPassword ? 'text' : 'password'}}"
          value="{{oldPassword}}"
          placeholder="请输入原密码"
          bindinput="onOldPasswordInput"
          maxlength="20"
        />
        <view class="toggle-password" bind:tap="toggleOldPasswordVisibility">
          <text class="eye-icon">{{showOldPassword ? '👁️' : '👁️‍🗨️'}}</text>
        </view>
      </view>
      <view class="error-message" wx:if="{{oldPasswordError}}">
        <text>{{oldPasswordError}}</text>
      </view>
    </view>

    <!-- 新密码 -->
    <view class="form-group">
      <view class="input-label">新密码</view>
      <view class="input-wrapper {{newPasswordError ? 'input-error' : ''}}">
        <input 
          class="form-input"
          type="{{showNewPassword ? 'text' : 'password'}}"
          value="{{newPassword}}"
          placeholder="请输入新密码（6-20位，包含字母和数字）"
          bindinput="onNewPasswordInput"
          maxlength="20"
        />
        <view class="toggle-password" bind:tap="toggleNewPasswordVisibility">
          <text class="eye-icon">{{showNewPassword ? '👁️' : '👁️‍🗨️'}}</text>
        </view>
      </view>
      <view class="error-message" wx:if="{{newPasswordError}}">
        <text>{{newPasswordError}}</text>
      </view>
      
      <!-- 密码强度指示器 -->
      <view class="password-strength" wx:if="{{newPassword.length > 0}}">
        <view class="strength-bar">
          <view class="strength-item {{passwordStrength >= 1 ? 'active' : ''}}" style="background-color: {{passwordStrength >= 1 ? passwordStrengthColor : '#e0e0e0'}}"></view>
          <view class="strength-item {{passwordStrength >= 2 ? 'active' : ''}}" style="background-color: {{passwordStrength >= 2 ? passwordStrengthColor : '#e0e0e0'}}"></view>
          <view class="strength-item {{passwordStrength >= 3 ? 'active' : ''}}" style="background-color: {{passwordStrength >= 3 ? passwordStrengthColor : '#e0e0e0'}}"></view>
        </view>
        <text class="strength-text" style="color: {{passwordStrengthColor}}">密码强度：{{passwordStrengthText}}</text>
      </view>
    </view>

    <!-- 确认密码 -->
    <view class="form-group">
      <view class="input-label">确认新密码</view>
      <view class="input-wrapper {{confirmPasswordError ? 'input-error' : ''}}">
        <input 
          class="form-input"
          type="{{showConfirmPassword ? 'text' : 'password'}}"
          value="{{confirmPassword}}"
          placeholder="请再次输入新密码"
          bindinput="onConfirmPasswordInput"
          maxlength="20"
        />
        <view class="toggle-password" bind:tap="toggleConfirmPasswordVisibility">
          <text class="eye-icon">{{showConfirmPassword ? '👁️' : '👁️‍🗨️'}}</text>
        </view>
      </view>
      <view class="error-message" wx:if="{{confirmPasswordError}}">
        <text>{{confirmPasswordError}}</text>
      </view>
    </view>

    <!-- 密码要求提示 -->
    <view class="password-tips">
      <view class="tips-title">密码要求：</view>
      <view class="tip-item">
        <text class="tip-icon {{oldPassword.length >= 6 ? 'tip-valid' : ''}}">•</text>
        <text class="tip-text">长度6-20个字符</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon {{hasLetterAndNumber ? 'tip-valid' : ''}}">•</text>
        <text class="tip-text">必须包含字母和数字</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon {{newPassword && newPassword !== oldPassword ? 'tip-valid' : ''}}">•</text>
        <text class="tip-text">不能与原密码相同</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button 
      class="submit-btn {{canSubmit && !loading ? '' : 'disabled'}}"
      bind:tap="onSubmit"
      disabled="{{!canSubmit || loading}}"
    >
      <view class="loading-spinner" wx:if="{{loading}}"></view>
      <text>{{loading ? '提交中...' : '确认修改'}}</text>
    </button>
  </view>
</view>