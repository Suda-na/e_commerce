<!-- 个人中心页面 -->
<view class="page-container">

  <!-- 用户信息卡片 - 金渐变 -->
  <view class="user-card">
    <view class="user-card-header">
      <!-- 头像 -->
      <view class="avatar-wrapper">
        <image
          class="avatar"
          src="{{userInfo.avatarUrl ? userInfo.avatarUrl : '/assets/icons/default-avatar.png'}}"
          mode="aspectFill"
          binderror="onAvatarError"
        />
      </view>
      
      <!-- 用户信息 -->
      <view class="user-info">
        <text class="nickname">{{isLoggedIn ? userInfo.nickname : '未登录'}}</text>
        <text class="user-id" wx:if="{{isLoggedIn}}">ID: {{userInfo.id || '---'}}</text>
      </view>
    </view>

    <view class="user-card-footer">
      <view wx:if="{{isLoggedIn}}" class="vip-badge">
        <text class="vip-icon">👑</text>
        <text>普通会员</text>
      </view>
      <view wx:if="{{!isLoggedIn}}" class="login-btn" bind:tap="onLoginTap">
        <text>立即登录</text>
      </view>
      <view wx:if="{{isLoggedIn}}" style="font-size: 24rpx; opacity: 0.8;">
        <text>已参与 {{stats.auctionCount || 0}} 场竞拍</text>
      </view>
    </view>
  </view>

  <!-- 统计数据卡片 -->
  <view class="stats-card" wx:if="{{isLoggedIn}}">
    <text class="stats-title">我的数据</text>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-value">{{stats.auctionCount || 0}}</text>
        <text class="stat-label">参与竞拍</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.bidCount || 0}}</text>
        <text class="stat-label">出价次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.winCount || 0}}</text>
        <text class="stat-label">中标次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.favoriteCount || 0}}</text>
        <text class="stat-label">收藏商家</text>
      </view>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="stats-card" wx:if="{{!isLoggedIn}}">
    <view class="empty-container" style="padding: 40rpx 0;">
      <text class="empty-icon">🔒</text>
      <text class="empty-text">登录后查看您的竞拍数据</text>
    </view>
  </view>

  <!-- 功能菜单 - 账号与安全 -->
  <view class="menu-card">
    <view class="menu-item" bind:tap="onEditProfile">
      <view class="menu-icon">✏️</view>
      <text class="menu-text">编辑资料</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="onChangePassword">
      <view class="menu-icon">🔑</view>
      <text class="menu-text">修改密码</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="onAddressForm">
      <view class="menu-icon">📍</view>
      <text class="menu-text">收货地址</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 功能菜单 - 竞拍与订单 -->
  <view class="menu-card">
    <view class="menu-item" bind:tap="onBidHistory">
      <view class="menu-icon">📋</view>
      <text class="menu-text">出价历史</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="onMyOrders">
      <view class="menu-icon">📦</view>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="onMyFavorites">
      <view class="menu-icon">❤️</view>
      <text class="menu-text">收藏商家</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 功能菜单 - 设置与反馈 -->
  <view class="menu-card">
    <view class="menu-item" bind:tap="onNotificationSetting">
      <view class="menu-icon">🔔</view>
      <text class="menu-text">消息通知</text>
      <view class="unread-badge" wx:if="{{unreadCount > 0}}">
        <text>{{unreadCount > 99 ? '99+' : unreadCount}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="onHelpFeedback">
      <view class="menu-icon">💬</view>
      <text class="menu-text">帮助与反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bind:tap="onAboutUs">
      <view class="menu-icon">ℹ️</view>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-card" wx:if="{{isLoggedIn}}">
    <view class="logout-btn" bind:tap="onLogout">
      <text>退出登录</text>
    </view>
  </view>

  <!-- 退出确认弹窗 -->
  <modal 
    visible="{{showLogoutModal}}" 
    title="退出登录" 
    content="确定要退出当前账号吗？退出后需要重新登录。"
    confirmText="退出"
    cancelText="取消"
    bind:confirm="confirmLogout"
    bind:cancel="cancelLogout"
    bind:close="cancelLogout"
  />
</view>
