<!-- 收货地址页面 -->
<view class="page-container">
  <!-- 表单区域 -->
  <view class="form-container">
    <!-- 收货人信息 -->
    <view class="section-card">
      <view class="section-title">收货人信息</view>
      
      <!-- 收货人姓名 -->
      <view class="form-group">
        <view class="input-label">收货人姓名</view>
        <view class="input-wrapper {{nameError ? 'input-error' : ''}}">
          <input 
            class="form-input"
            type="text"
            value="{{receiverName}}"
            placeholder="请输入收货人真实姓名"
            bindinput="onNameInput"
            maxlength="50"
          />
        </view>
        <view class="error-message" wx:if="{{nameError}}">
          <text>{{nameError}}</text>
        </view>
      </view>

      <!-- 手机号 -->
      <view class="form-group">
        <view class="input-label">手机号</view>
        <view class="input-wrapper {{phoneError ? 'input-error' : ''}}">
          <input 
            class="form-input"
            type="number"
            value="{{receiverPhone}}"
            placeholder="请输入收货人手机号"
            bindinput="onPhoneInput"
            maxlength="11"
          />
        </view>
        <view class="error-message" wx:if="{{phoneError}}">
          <text>{{phoneError}}</text>
        </view>
      </view>
    </view>

    <!-- 收货地址 -->
    <view class="section-card">
      <view class="section-title">收货地址</view>
      
      <!-- 省市区选择 -->
      <view class="form-group">
        <view class="input-label">所在地区</view>
        <picker mode="region" value="{{region}}" bindchange="onRegionChange">
          <view class="input-wrapper picker-wrapper {{addressError && !province ? 'input-error' : ''}}">
            <text class="picker-text {{province ? '' : 'placeholder'}}">
              {{province ? (province + ' ' + city + ' ' + district) : '请选择省市区'}}
            </text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>

      <!-- 详细地址 -->
      <view class="form-group">
        <view class="input-label">详细地址</view>
        <view class="input-wrapper textarea-wrapper {{addressError && !detailAddress ? 'input-error' : ''}}">
          <textarea 
            class="form-textarea"
            value="{{detailAddress}}"
            placeholder="请输入详细地址，如街道、门牌号、小区名等"
            bindinput="onAddressInput"
            maxlength="255"
            auto-height
          />
        </view>
        <view class="error-message" wx:if="{{addressError}}">
          <text>{{addressError}}</text>
        </view>
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="tips-section">
      <view class="tips-title">温馨提示</view>
      <view class="tip-item">
        <text class="tip-icon">•</text>
        <text class="tip-text">请确保收货信息准确，以免影响商品配送</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">•</text>
        <text class="tip-text">每个账号只能保存一个收货地址</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">•</text>
        <text class="tip-text">竞拍成功后将使用此地址进行发货</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button 
      class="submit-btn {{canSubmit && !loading ? '' : 'disabled'}}"
      bind:tap="onSubmit"
      disabled="{{!canSubmit || loading}}"
    >
      <view class="loading-spinner" wx:if="{{loading}}"></view>
      <text>{{loading ? '保存中...' : '保存地址'}}</text>
    </button>
    
    <button 
      class="clear-btn"
      bind:tap="onClear"
      wx:if="{{isEdit}}"
    >
      <text>清空地址</text>
    </button>
  </view>
</view>