/* pages/test/test.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
}

/* 状态切换按钮 */
.state-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.state-btn {
  flex: 1;
  min-width: 30%;
  padding: 15rpx 10rpx;
  font-size: 24rpx;
  background-color: #f0f0f0;
  color: #666;
  border-radius: 8rpx;
  border: none;
  line-height: 1.4;
}

.state-btn.active {
  background-color: #1890ff;
  color: #fff;
}

.state-btn::after {
  border: none;
}

/* 状态预览 */
.tip-preview {
  padding: 20rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e8e8e8;
}

.tip-preview.default {
  background-color: #FFF7E6;
  border-color: #FFD591;
}

.tip-preview.high-bid {
  background-color: #E6F7FF;
  border-color: #91D5FF;
}

.tip-preview.highest {
  background-color: #F6FFED;
  border-color: #B7EB8F;
}

.tip-preview.ending-soon {
  background-color: #FFF1F0;
  border-color: #FFCCC7;
}

.tip-preview.outbid {
  background-color: #FFF0F6;
  border-color: #FFADD2;
}

.tip-preview.cap-warning {
  background-color: #FFF7E6;
  border-color: #FFD591;
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.tip-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.tip-type {
  font-size: 24rpx;
  color: #666;
  background-color: rgba(0, 0, 0, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.tip-text {
  font-size: 28rpx;
  line-height: 1.5;
}

.tip-preview.default .tip-text {
  color: #D46B08;
}

.tip-preview.high-bid .tip-text {
  color: #096DD9;
}

.tip-preview.highest .tip-text {
  color: #389E0D;
}

.tip-preview.ending-soon .tip-text {
  color: #CF1322;
}

.tip-preview.outbid .tip-text {
  color: #C41D7F;
}

.tip-preview.cap-warning .tip-text {
  color: #D46B08;
}

/* 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15rpx;
}

.info-item {
  background-color: #f9f9f9;
  padding: 15rpx;
  border-radius: 8rpx;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 测试按钮 */
.test-buttons {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.test-btn {
  flex: 1;
  min-width: 30%;
  padding: 20rpx 15rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.4;
}

.test-btn.primary {
  background-color: #1890ff;
  color: #fff;
}

.test-btn.secondary {
  background-color: #f0f0f0;
  color: #333;
}

.test-btn::after {
  border: none;
}

/* 测试结果 */
.test-results {
  background-color: #f9f9f9;
  border-radius: 8rpx;
  padding: 20rpx;
}

.result-summary {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #eee;
}

.result-count {
  font-size: 28rpx;
  color: #52c41a;
  font-weight: bold;
}

.result-count.fail {
  color: #ff4d4f;
}

.result-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 15rpx;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
  background-color: #fff;
}

.result-item.pass {
  border-left: 8rpx solid #52c41a;
}

.result-item.fail {
  border-left: 8rpx solid #ff4d4f;
}

.result-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
  font-weight: bold;
}

.result-item.pass .result-icon {
  color: #52c41a;
}

.result-item.fail .result-icon {
  color: #ff4d4f;
}

.result-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.result-detail {
  font-size: 24rpx;
  color: #666;
}

/* 颜色验证 */
.color-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
}

.color-item {
  background-color: #f9f9f9;
  padding: 15rpx;
  border-radius: 8rpx;
  text-align: center;
}

.color-name {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.color-preview {
  width: 100%;
  height: 60rpx;
  border-radius: 4rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid #e8e8e8;
}

.color-value {
  display: block;
  font-size: 22rpx;
  color: #999;
  font-family: monospace;
}

/* 测试报告 */
.report-box {
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.report-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.6;
  white-space: pre-wrap;
  font-family: monospace;
}