<!--index.wxml-->
<view class="container">
  <!-- Logo 区域 -->
  <view class="logo-area">
    <image class="logo" src="/assets/icons/tab-live.png" mode="aspectFit"></image>
    <text class="app-name">直播竞拍大师</text>
    <text class="app-slogan">实时竞拍，低价捡漏</text>
  </view>
  
  <!-- 加载状态 -->
  <view class="loading-area" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="status-text">{{statusText}}</text>
  </view>
  
  <!-- 重试按钮 -->
  <view class="retry-area" wx:if="{{!loading}}">
    <button class="btn-primary retry-btn" bindtap="onRetry">重试</button>
  </view>
  
  <!-- 版本信息 -->
  <view class="version-area">
    <text class="version-text">v1.0.0</text>
  </view>
</view>