<!--
  订单列表页面
  功能：展示用户的所有订单，支持状态筛选、下拉刷新、分页加载
-->
<view class="orders-page">

  <!-- ===== 页面标题 ===== -->
  <view class="page-header">
    <text class="page-title">我的订单</text>
    <text class="page-subtitle">查看竞拍订单和支付状态</text>
  </view>

  <!-- ===== 状态筛选Tab ===== -->
  <view class="status-tabs">
    <scroll-view class="tabs-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="tabs-wrapper">
        <view
          class="tab-item {{currentStatus === item.key ? 'active' : ''}}"
          wx:for="{{statusTabs}}"
          wx:key="key"
          data-status="{{item.key}}"
          bindtap="onStatusChange"
        >
          <text class="tab-text">{{item.label}}</text>
          <view class="tab-indicator" wx:if="{{currentStatus === item.key}}" />
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- ===== 订单列表 ===== -->
  <scroll-view
    class="order-list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    bindscrolltolower="onReachBottom"
  >
    <!-- 骨架屏加载状态 -->
    <skeleton wx:if="{{loading && orders.length === 0}}" type="card" rows="{{3}}" animate="{{true}}">
      <!-- 骨架屏占位 -->
    </skeleton>

    <!-- 空状态 -->
    <view class="empty-state" wx:elif="{{isEmpty}}">
      <text class="empty-icon">📦</text>
      <text class="empty-title">暂无订单</text>
      <text class="empty-desc">您还没有任何订单，去直播间参与竞拍吧</text>
      <view class="empty-action" bindtap="goToDiscover">
        <text class="action-text">去发现</text>
      </view>
    </view>

    <!-- 订单列表 -->
    <view class="order-grid" wx:else>
      <view
        class="order-card"
        wx:for="{{orders}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goToOrderDetail"
      >
        <!-- 订单头部：订单号和状态 -->
        <view class="order-header">
          <view class="order-no">
            <text class="order-no-label">订单号：</text>
            <text class="order-no-value">{{item.id}}</text>
          </view>
          <view class="order-status" style="background-color: {{getStatusColor(item.status)}}">
            <text class="status-text">{{getStatusText(item.status)}}</text>
          </view>
        </view>

        <!-- 订单内容：商品信息 -->
        <view class="order-content">
          <!-- 商品图片 -->
          <view class="product-image-wrapper">
            <image
              class="product-image"
              src="{{item.auction.product.images[0] || '/assets/images/default-live.png'}}"
              mode="aspectFill"
              lazy-load
            />
          </view>

          <!-- 商品信息 -->
          <view class="product-info">
            <text class="product-name">{{item.auction.product.name || '未知商品'}}</text>
            <text class="product-auction">竞拍 #{{item.auctionId}}</text>
            <view class="order-amount">
              <text class="amount-label">订单金额：</text>
              <text class="amount-value">{{item.amountDisplay}}</text>
            </view>
          </view>
        </view>

        <!-- 订单底部：时间和操作按钮 -->
        <view class="order-footer">
          <text class="order-time">{{formatTime(item.createdAt)}}</text>
          
          <!-- 操作按钮 -->
          <view class="order-actions">
            <!-- 待付款状态：显示支付和取消按钮 -->
            <block wx:if="{{item.status === 'pending'}}">
              <view class="action-btn cancel-btn" data-id="{{item.id}}" catchtap="handleCancelOrder">
                <text class="btn-text">取消订单</text>
              </view>
              <view class="action-btn pay-btn" data-id="{{item.id}}" catchtap="handlePayOrder">
                <text class="btn-text">模拟支付</text>
              </view>
            </block>
            
            <!-- 已付款状态：显示查看详情按钮 -->
            <block wx:elif="{{item.status === 'paid'}}">
              <view class="action-btn detail-btn" data-id="{{item.id}}" catchtap="goToOrderDetail">
                <text class="btn-text">查看详情</text>
              </view>
            </block>
            
            <!-- 已发货状态：显示查看详情按钮 -->
            <block wx:elif="{{item.status === 'shipped'}}">
              <view class="action-btn detail-btn" data-id="{{item.id}}" catchtap="goToOrderDetail">
                <text class="btn-text">查看物流</text>
              </view>
            </block>

            <!-- 退款中/已退款/已取消状态：显示查看详情按钮 -->
            <block wx:elif="{{item.status === 'refunding' || item.status === 'refunded' || item.status === 'cancelled'}}">
              <view class="action-btn detail-btn" data-id="{{item.id}}" catchtap="goToOrderDetail">
                <text class="btn-text">查看详情</text>
              </view>
            </block>
          </view>
        </view>
      </view>

      <!-- 加载更多提示 -->
      <view class="load-more" wx:if="{{loadingMore}}">
        <view class="loading-spinner small" />
        <text class="load-more-text">加载中...</text>
      </view>

      <!-- 没有更多数据 -->
      <view class="no-more" wx:if="{{noMore && orders.length > 0}}">
        <text class="no-more-text">— 没有更多订单了 —</text>
      </view>
    </view>
  </scroll-view>

</view>