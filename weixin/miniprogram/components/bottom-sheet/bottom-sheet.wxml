<!--bottom-sheet.wxml-->
<view class="bottom-sheet {{visible ? 'show' : 'hide'}}" bind:touchmove="preventTouchMove">
  <!-- 遮罩层 -->
  <view class="mask" bind:tap="onClose"></view>
  
  <!-- 内容区域 -->
  <view 
    class="content" 
    style="height: {{height}}; max-height: {{maxHeight}}; transform: translateY({{translateY}}px);"
    animation="{{animationData}}"
    bind:tap="onContentTap"
  >
    <!-- 拖拽区域 -->
    <view 
      class="drag-area" 
      bind:touchstart="onTouchStart"
      bind:touchmove="onTouchMove"
      bind:touchend="onTouchEnd"
      bind:tap="onDragAreaTap"
    >
      <view class="drag-handle"></view>
    </view>
    
    <!-- 标题栏 -->
    <view class="header" wx:if="{{title}}">
      <text class="title">{{title}}</text>
      <view class="close-btn" bind:tap="onClose">
        <text class="close-icon">×</text>
      </view>
    </view>
    
    <!-- 内容插槽 -->
    <view class="body">
      <slot></slot>
    </view>
  </view>
</view>