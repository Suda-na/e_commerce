# 安全配置环境变量示例
# 复制此文件为 .env 并填入实际值

# ==================== JWT配置 ====================
# Access Token密钥（必须设置，生产环境使用强随机字符串）
JWT_SECRET=your_jwt_secret_key_here

# Access Token过期时间（如：15m, 1h, 7d）
JWT_EXPIRES_IN=15m

# Refresh Token密钥（必须设置，生产环境使用强随机字符串）
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Refresh Token过期时间
JWT_REFRESH_EXPIRES_IN=7d

# ==================== 数据加密配置 ====================
# 数据加密密钥（必须设置，32字节十六进制字符串）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# ==================== API签名配置 ====================
# 是否启用API签名验证
API_SIGNATURE_ENABLED=false

# API签名密钥
API_SIGNATURE_SECRET=

# ==================== HTTPS配置 ====================
# SSL证书路径（生产环境）
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_CA_PATH=

# ==================== 安全头配置 ====================
# CORS允许的源
CORS_ORIGIN=http://localhost:3000

# ==================== 频率限制配置 ====================
# 全局频率限制（15分钟内最大请求数）
RATE_LIMIT_MAX=100

# 登录频率限制（15分钟内最大尝试次数）
LOGIN_RATE_LIMIT_MAX=5

# 注册频率限制（1小时内最大尝试次数）
REGISTER_RATE_LIMIT_MAX=3

# ==================== 会话配置 ====================
# 最大并发会话数
MAX_CONCURRENT_SESSIONS=3

# 会话空闲超时（分钟）
SESSION_IDLE_TIMEOUT=30

# 会话绝对超时（分钟）
SESSION_ABSOLUTE_TIMEOUT=480

# ==================== 密码策略 ====================
# 密码最小长度
PASSWORD_MIN_LENGTH=8

# 密码最大长度
PASSWORD_MAX_LENGTH=128

# 是否要求大写字母
PASSWORD_REQUIRE_UPPERCASE=true

# 是否要求小写字母
PASSWORD_REQUIRE_LOWERCASE=true

# 是否要求数字
PASSWORD_REQUIRE_NUMBERS=true

# 是否要求特殊字符
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# ==================== 账户锁定配置 ====================
# 最大登录失败次数
MAX_LOGIN_ATTEMPTS=5

# 登录失败锁定时间（秒）
LOGIN_LOCKOUT_DURATION=900

# ==================== 审计日志配置 ====================
# 是否启用审计日志
AUDIT_ENABLED=true

# 审计日志文件路径
AUDIT_LOG_FILE=logs/security-audit.log

# 审计日志最大文件大小（MB）
AUDIT_MAX_FILE_SIZE=50

# 审计日志最大文件数量
AUDIT_MAX_FILES=10

# 审计日志保留天数
AUDIT_RETENTION_DAYS=90

# ==================== WebSocket安全配置 ====================
# 每个IP最大WebSocket连接数
WS_MAX_CONNECTIONS_PER_IP=5

# 全局最大WebSocket连接数
WS_MAX_TOTAL_CONNECTIONS=1000

# WebSocket连接超时（毫秒）
WS_CONNECTION_TIMEOUT=10000

# WebSocket每分钟最大消息数
WS_MAX_MESSAGES_PER_MINUTE=60

# ==================== 其他安全配置 ====================
# 是否强制HTTPS
FORCE_HTTPS=false

# 是否启用HSTS
HSTS_ENABLED=true

# HSTS最大年龄（秒）
HSTS_MAX_AGE=31536000

# 是否启用CSRF防护
CSRF_ENABLED=true

# ==================== 日志配置 ====================
# 日志级别
LOG_LEVEL=debug

# 日志文件路径
LOG_FILE=logs/app.log

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auction_db

# ==================== Redis配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== 服务器配置 ====================
PORT=3001
NODE_ENV=development