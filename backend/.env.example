# 环境变量配置模板
# 复制此文件为 .env 并修改配置

# 应用配置
NODE_ENV=development
PORT=3001

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=auction_db

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# JWT配置
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS配置
CORS_ORIGIN=http://localhost:3000

# 日志配置
LOG_LEVEL=debug

# AI服务配置（火山方舟）
ARK_API_KEY=your_ark_api_key_here
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-1-5-pro-32k-250115
ARK_ENDPOINT_ID=your_endpoint_id_here

# AI限流配置
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10

# AI重试配置
AI_MAX_RETRIES=3
AI_RETRY_DELAY=1000

# AI缓存配置
AI_CACHE_ENABLED=true
AI_CACHE_TTL=300000

# 速率限制
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# 竞拍配置
AUCTION_DEFAULT_DURATION=300
AUCTION_DEFAULT_DELAY=10
AUCTION_MAX_DELAY=30

# 补充安全配置
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
DATA_ENCRYPTION_KEY=your_data_encryption_key_here_64_chars_long
API_SIGNATURE_SECRET=your_api_signature_secret_here